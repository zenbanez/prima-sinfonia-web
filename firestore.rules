rules_version = '2';

// Teacher status comes only from /teachers/{uid}, a list that only the owner
// sets (with scripts/grant-teacher.mjs and admin credentials). The `role`
// field on a user's own profile is never trusted for permissions, and users
// can't change it. (WS-0068/D-003)

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTeacher() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Teacher list: written only with admin credentials ---
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId);
      allow write: if false;
    }

    // --- User Rules ---
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Verified teachers can read all profiles
      allow read: if isTeacher();
      // A new profile is always a student profile
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      // Users can update their own profile, but never their role
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if isOwner(userId);
    }

    // --- Lesson Rules ---
    match /lessons/{lessonId} {
      // Teachers can manage lessons where they are the teacher
      allow read, write: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      // Also allow reading if they are already the teacher of the lesson
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      
      // Students can read lessons where they are the student
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }

    // --- Practice Session Rules ---
    match /practice_sessions/{sessionId} {
      // Students can manage their own practice sessions
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.studentId == request.auth.uid) || 
        (resource != null && resource.data.studentId == request.auth.uid)
      );
      
      // Teachers can read all practice sessions
      allow read: if isTeacher();
    }

    // --- Resource Rules ---
    match /resources/{resourceId} {
      // All authenticated users can read resources
      allow read: if isAuthenticated();
      // Only teachers can manage resources
      allow write: if isTeacher();
    }
  }
}
