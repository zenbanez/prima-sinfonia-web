rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- User Rules ---
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if isOwner(userId);
      // Teachers can read all student profiles
      allow read: if isTeacher();
    }

    // --- Lesson Rules ---
    match /lessons/{lessonId} {
      // Teachers can manage lessons where they are the teacher
      allow read, write: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      // Also allow reading if they are already the teacher of the lesson
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      
      // Students can read lessons where they are the student
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }

    // --- Practice Session Rules ---
    match /practice_sessions/{sessionId} {
      // Students can manage their own practice sessions
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.studentId == request.auth.uid) || 
        (resource != null && resource.data.studentId == request.auth.uid)
      );
      
      // Teachers can read all practice sessions
      allow read: if isTeacher();
    }

    // --- Resource Rules ---
    match /resources/{resourceId} {
      // All authenticated users can read resources
      allow read: if isAuthenticated();
      // Only teachers can manage resources
      allow write: if isTeacher();
    }
  }
}
